  <!-- that they should prefer consuming it instead. -->
  <!-- do_not_remove: published-with-gradle-metadata -->
  <modelVersion>4.0.0</modelVersion>
  <groupId>com.simsilica</groupId>
  <artifactId>sim-ethereal</artifactId>
  <version>1.8.1-SNAPSHOT</version>
  <name>com.simsilica:sim-ethereal</name>
  <description>A real-time network sync library in Java.</description>
  <url>https://github.com/Simsilica/SimEthereal</url>
  <inceptionYear>2011</inceptionYear>
  <licenses>
    <license>
      <name>New BSD (3-clause) License</name>
      <url>https://github.com/Simsilica/SimEthereal/blob/master/license.md</url>
      <distribution>repo</distribution>
    </license>
  </licenses>
  <developers>
    <developer>
      <name>Paul Speed</name>
    </developer>
  </developers>
  <scm>
    <connection>scm:git:git://github.com/Simsilica/SimEthereal.git</connection>
    <developerConnection>scm:git:ssh://github.com:Simsilica/SimEthereal.git</developerConnection>
    <url>https://github.com/Simsilica/SimEthereal/tree/master</url>
  </scm>
  <dependencies>
    <dependency>
      <groupId>org.jmonkeyengine</groupId>
      <artifactId>jme3-networking</artifactId>
      <version>3.1.0-stable</version>
      <scope>compile</scope>
    </dependency>
    <dependency>
      <groupId>com.simsilica</groupId>
      <artifactId>sim-math</artifactId>
      <version>1.6.1-SNAPSHOT</version>
      <scope>compile</scope>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-api</artifactId>
      <version>1.7.32</version>
      <scope>runtime</scope>
    </dependency>
  </dependencies>
</project>
