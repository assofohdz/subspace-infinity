<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="WARN">
  <Appenders>
    <Console name="Console" target="SYSTEM_OUT">
      <PatternLayout pattern="%d{HH:mm:ss.SSS} [%t] %-5level %logger{36} - %msg%n"/>
    </Console>
    <!-- File appender for persistent logging - useful for crash diagnosis -->
    <RollingFile name="File" fileName="logs/infinity.log" filePattern="logs/infinity-%d{yyyy-MM-dd}-%i.log.gz">
      <PatternLayout pattern="%d{yyyy-MM-dd HH:mm:ss.SSS} [%t] %-5level %logger{36} - %msg%n"/>
      <Policies>
        <SizeBasedTriggeringPolicy size="10 MB"/>
        <TimeBasedTriggeringPolicy interval="1"/>
      </Policies>
      <DefaultRolloverStrategy max="5"/>
    </RollingFile>
    <!-- Error-only file for quick crash diagnosis -->
    <RollingFile name="ErrorFile" fileName="logs/infinity-errors.log" filePattern="logs/infinity-errors-%d{yyyy-MM-dd}-%i.log.gz">
      <PatternLayout pattern="%d{yyyy-MM-dd HH:mm:ss.SSS} [%t] %-5level %logger{36} - %msg%n%throwable"/>
      <Policies>
        <SizeBasedTriggeringPolicy size="5 MB"/>
      </Policies>
      <DefaultRolloverStrategy max="3"/>
      <ThresholdFilter level="ERROR"/>
    </RollingFile>
  </Appenders>
  <Loggers>
    <Logger name="infinity.systems" level="INFO" additivity="false">
      <AppenderRef ref="Console"/>
      <AppenderRef ref="File"/>
    </Logger>
    <Logger name="infinity.sim" level="debug" additivity="false">
      <AppenderRef ref="Console"/>
      <AppenderRef ref="File"/>
    </Logger>
    <Logger name="infinity.settings" level="INFO" additivity="false">
      <AppenderRef ref="Console"/>
      <AppenderRef ref="File"/>
    </Logger>
    <!-- AI + module packages: WARN keeps per-tick Brain.think / BrainScheduler.schedule /
         MobBodyInitializer.apply chatter off the console while still surfacing real warnings
         (e.g. BrainScheduler endless-loop). Bump to INFO when debugging AI/module wiring;
         without these loggers everything in these packages falls through to Root=error and
         even WARN goes missing — that's how the kill-event RMI loop hid for so long. -->
    <Logger name="infinity.ai" level="WARN" additivity="false">
      <AppenderRef ref="Console"/>
      <AppenderRef ref="File"/>
    </Logger>
    <Logger name="infinity.modules" level="WARN" additivity="false">
      <AppenderRef ref="Console"/>
      <AppenderRef ref="File"/>
    </Logger>
    <Logger name="infinity.client.states.LocalViewState" level="ALL" additivity="false">
      <AppenderRef ref="Console"/>
      <AppenderRef ref="File"/>
    </Logger>
    <Logger name="infinity.client" level="info" additivity="false">
      <AppenderRef ref="Console"/>
      <AppenderRef ref="File"/>
    </Logger>
    <Logger name="infinity.server" level="debug" additivity="false">
      <AppenderRef ref="Console"/>
      <AppenderRef ref="File"/>
    </Logger>
    <Logger name="infinity.systems.ContactSystem" level="WARN" additivity="false">
      <AppenderRef ref="Console"/>
    </Logger>
    <Logger name="infinity.server.DefaultColumnDb" level="WARN" additivity="false">
      <AppenderRef ref="Console"/>
      <AppenderRef ref="File"/>
    </Logger>
    <Logger name="infinity.client.states.ModelViewState" level="FATAL"/>
    <Logger name="com.simsilica.mblock.geom.ColliderlessMesh" level="FATAL"/>
    <Logger name="com.simsilica.mblock.phys.collision.ColliderFactories" level="FATAL"/>
    <Logger name="com.simsilica.ext.mblock.SphereFactory" level="FATAL"/>
    <Logger name="com.simsilica.ext.mphys.debug.BinStatusState" level="INFO"/>
    <Logger name="com.simsilica.mphys.BinIndex" level="FATAL"/>
    <Logger name="com.simsilica.mphys.Bin" level="FATAL"/>
    <Logger name="com.simsilica.mphys.BinIndex" level="FATAL"/>
    <Logger name="com.simsilica.mphys" level="DEBUG"/>
    <Logger name="com.simsilica.ext.mphys.EntityBodyFactory" level="FATAL"/>
    <Logger name="com.simsilica.ext.mphys.BinEntityManager" level="FATAL"/>
    <Logger name="com.simsilica.ext.mphys.debug.BinStatusState" level="FATAL"/>
    <Logger name="com.simsilica.ext.mphys" level="DEBUG"/>
    <Logger name="com.simsilica.mworld.net.server.WorldHostedService" level="FATAL"/>
    <Logger name="com.simsilica.mworld.net.client.WorldClientService" level="FATAL"/>
    <Logger name="com.simsilica.mworld.net.client.RemoteWorldData" level="FATAL"/>
    <Logger name="com.simsilica.mworld.db.ColumnDbLeafDbAdapter" level="FATAL"/>
    <Logger name="com.simsilica.mworld.db.AbstractObjectDb" level="WARN"/>
    <Logger name="com.simsilica.lemur.style" level="DEBUG"/>
    <Logger name="com.simsilica.es" level="INFO"/>
    <Logger name="com.simsilica.ethereal" level="FATAL"/>
    <Logger name="com.simsilica.sim.common.DecaySystem" level="FATAL"/>
    <Logger name="com.simsilica.mblock" level="DEBUG"/>
    <Logger name="com.simsilica.mworld" level="DEBUG"/>
    <Logger name="com.simsilica.builderr" level="INFO"/>
    <Logger name="com.simsilica.pager" level="INFO"/>
    <Root level="error">
      <AppenderRef ref="Console"/>
      <AppenderRef ref="File"/>
      <AppenderRef ref="ErrorFile"/>
    </Root>
  </Loggers>
</Configuration>