# Compiled class file
*.class

# Log file
*.log

# BlueJ files
*.ctxt

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# Package Files #
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# JDT-specific (Eclipse Java Development Tools)     
# .classpath

# binary folders
bin/

# virtual machine crash logs, see http://www.java.com/en/download/help/error_hotspot.xml
hs_err_pid*

# Edit backup directories
.backups/

# Local-only reference snapshots (e.g. SubspaceServer config copies).
# Not part of the build; kept handy for design comparison.
.reference/

# gradle related directories
.gradle/
build/
!gradle/wrapper/gradle-wrapper.jar
!libs/**/*.jar

# We shouldn't be checking in DLLs but we will find them in our JME source
# try all the time... best to skip them
*.dll
*.so

# In our project, logs directories are generated by the app and we never
# want to check them in.
logs/

# Voxel world state (generated by DefaultColumnDb at runtime).
# Dev-only file-backed store; production deployments use a real DB.
# Run/test workingDir is rootProject.projectDir so it lands at top level;
# legacy locations under module dirs kept as safety nets.
/world.db/
infinity-client/world.db/
infinity-server/world.db/
/.idea/checkstyleidea-libs/readme.txt
/.idea/checkstyle-idea.xml

# Per-user MCP servers (personal tool configs, not team dependencies)
.mcp.json

# MemPalace per-project files (issue #185)
mempalace.yaml
entities.json

# Claude Code transient state
.claude/scheduled_tasks.lock
.claude/worktrees/

# graphify knowledge graph — regenerable via /graphify, per-machine cache
graphify-out/
