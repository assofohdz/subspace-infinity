MaterialDef TileLit {

    MaterialParameters {
        Texture2D ColorMap
        Float AlphaDiscardThreshold (AlphaTestFallOff)
        Float PoolGain
        Float SunScale
        Float Exposure
        Float TextureGamma
        Boolean DebugShipLight
        Boolean DebugLeafGrid
    }

    Technique {
        LightMode SinglePass

        VertexShader GLSL100 GLSL150:   MatDefs/TileLit.vert
        FragmentShader GLSL100 GLSL150: MatDefs/TileLit.frag

        WorldParameters {
            WorldViewProjectionMatrix
            WorldViewMatrix
            NormalMatrix
            AmbientLightColor
        }

        Defines {
            DISCARD_ALPHA : AlphaDiscardThreshold
            DEBUG_SHIP_LIGHT : DebugShipLight
            DEBUG_LEAF_GRID : DebugLeafGrid
        }
    }
}
